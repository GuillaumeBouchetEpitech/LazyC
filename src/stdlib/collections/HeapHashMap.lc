  StringData safeType = String__replaceAll2(inType, "*", "Ptr");
  StringData pointerLessType = String__replaceAll2(inType, "*", "");

  StringData newDataA = String__replaceAll2(k_str, "{SAFE_TYPE}", safeType.data);
  StringData newDataB = String__replaceAll2(newDataA.data, "{RAW_TYPE}", inType);
  StringData newDataC = String__replaceAll2(newDataB.data, "{PTRLESS_TYPE}", pointerLessType.data);

  printf("%s\n", newDataC.data);

  free(newDataC.data);
  free(newDataB.data);
  free(newDataA.data);
  free(pointerLessType.data);
  free(safeType.data);
}
