

#include "stdlib/strings/replaceAll2.h"

#include <stdlib.h>
#include <stdio.h>
#include <string.h>

export comptime void HeapArray(const char* inType) {
  const char* k_str = ```

///comptime-lazy-c: "text-replace" "HeapArray<{TYPE}>" "HeapArray__{TYPE}"
///comptime-lazy-c: "resolve-includes" "{TYPE}"

#include <stdlib.h>
#include <stdio.h>
#include <memory.h>

export struct HeapArray__{TYPE} {
  {TYPE}* data;
  unsigned int len;
  unsigned int cap;
};

export HeapArray__{TYPE}* HeapArray__{TYPE}__preAllocated(unsigned int inCapacity) {

  HeapArray__{TYPE} *self = calloc(1, sizeof(HeapArray__{TYPE}));
  if (!self)
  {
    return NULL;
  }

  self->len = 0;
  self->cap = inCapacity < 32 ? 32 : inCapacity;
  self->data = calloc(self->cap, sizeof({TYPE}));
  if (!self->data)
  {
    free(self);
    return NULL;
  }

  return self;
}

export void HeapArray__{TYPE}__free(HeapArray__{TYPE}** self) {
  if (!self || !*self)
  {
    return;
  }
  free((*self)->data);
  free(*self);
  *self = NULL;
}

static int _HeapArray__{TYPE}__grow(HeapArray__{TYPE} *self, unsigned int inNewCapacity)
{
  if (self->cap >= inNewCapacity)
  {
    return 0;
  }
  while (self->cap < inNewCapacity)
  {
    self->cap *= 2;
  }
  self->data = realloc(self->data, self->cap * sizeof(void *));
  return self->data == NULL ? -1 : 0;
}

int HeapArray__{TYPE}__pushBack(HeapArray__{TYPE} *self, {TYPE} *inData)
{
  if (_HeapArray__{TYPE}__grow(self, self->len + 1) != 0)
  {
    return -1;
  }
  self->data[self->len] = *inData;
  ++self->len;
  return 0;
}

int HeapArray__{TYPE}__popBack(HeapArray__{TYPE} *self)
{
  if (self->len > 0)
  {
    --self->len;
    memset(&self->data[self->len], 0, sizeof({TYPE}));
    // self->data[--self->len] = NULL;
    return 0;
  }
  return -1;
}

void HeapArray__{TYPE}__clear(HeapArray__{TYPE} *self)
{
  self->len = 0;
}

// export void HeapArray__{TYPE}__clear(HeapArray__{TYPE}* self) {
//   self->len = 0;
// }

// export {TYPE}* HeapArray__{TYPE}__acquire(HeapArray__{TYPE}* self) {
//   if (self->len == self->cap) {
//     return NULL;
//   }
//   {TYPE}* retVal = &self->data[self->len];
//   self->len += 1;
//   return retVal;
// }

```;

  // unsigned int cleanLineLen = strlen(k_str) * 2;
  // char* cleanLineStr = calloc(cleanLineLen, sizeof(char));

  StringData newData = String__replaceAll2(k_str, "{TYPE}", inType);

  printf("%s\n", newData.data);
  free(newData.data);
}
